[Unit]
Description=MyDiet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mydiet
Group=mydiet
WorkingDirectory=/opt/mydiet
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=API_PORT=8080
Environment=MYDIET_DB=/var/lib/mydiet/mydiet.db
Environment=MYDIET_DEMO_DB=/var/lib/mydiet/demo.db
EnvironmentFile=/etc/mydiet.env
ExecStart=/usr/local/bin/node server/index.ts
Restart=always
RestartSec=5

# The app only writes its databases and uploaded images.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/mydiet/uploads /var/lib/mydiet

[Install]
WantedBy=multi-user.target
