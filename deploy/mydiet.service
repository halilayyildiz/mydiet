[Unit]
Description=MyDiet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mydiet
Group=mydiet
WorkingDirectory=/opt/mydiet
EnvironmentFile=/etc/mydiet.env
ExecStart=/opt/mydiet/.venv/bin/gunicorn --bind 127.0.0.1:8080 --workers 1 --threads 4 --timeout 120 --forwarded-allow-ips 127.0.0.1 --access-logfile - mydiet.wsgi:app
Restart=always
RestartSec=5

# The app only writes uploaded images (and gunicorn its control socket in the home dir).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/mydiet/uploads /var/lib/mydiet

[Install]
WantedBy=multi-user.target
